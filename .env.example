# Resend (https://resend.com) sends the email notification for every intake
# form submission (including any uploaded file, as an attachment).
#
# 1. Create a free Resend account: https://resend.com/signup
# 2. Create an API key: https://resend.com/api-keys
RESEND_API_KEY=

# The "from" address on outgoing notification emails. Resend's shared
# sandbox sender (onboarding@resend.dev) works with no setup, but it can
# only deliver to the email address you signed up to Resend with. To send
# to any address, verify a sending domain in Resend
# (https://resend.com/domains — e.g. landownersignal.com) and use an
# address on that domain instead.
RESEND_FROM_EMAIL="Landownersignal <onboarding@resend.dev>"

# Where intake form submissions are delivered. Defaults to
# hayeslegalsolutions@hayeslegalsolutions.com if left unset.
INTAKE_NOTIFICATION_EMAIL=hayeslegalsolutions@hayeslegalsolutions.com

# Stripe (https://stripe.com) powers the shop's hosted checkout.
#
# 1. Create a Stripe account: https://dashboard.stripe.com/register
# 2. Stay in test mode while developing (the toggle is in the dashboard
#    sidebar) — test-mode keys start with sk_test_/whsec_test_ and use
#    Stripe's test card numbers, no real money moves.
# 3. Secret key: Developers > API keys > Secret key.
STRIPE_SECRET_KEY=

# Webhook signing secret: Developers > Webhooks > Add endpoint, with URL
# https://yourdomain.com/api/webhooks/stripe and the checkout.session.completed
# event selected. After creating it, reveal the "Signing secret" and put it
# here. For local testing, run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` instead — it prints a temporary
# whsec_... value for you to use locally.
STRIPE_WEBHOOK_SECRET=

# Where paid shop orders are emailed for manual fulfillment. Defaults to
# hayeslegalsolutions@hayeslegalsolutions.com if left unset. Reuses
# RESEND_API_KEY / RESEND_FROM_EMAIL above — no separate email setup needed.
ORDER_NOTIFICATION_EMAIL=hayeslegalsolutions@hayeslegalsolutions.com
